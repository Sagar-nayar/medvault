# copy this to infra/.env and fill it in. infra/.env is gitignored, NEVER commit it
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-please

# sonarcloud.io > My Account > Security > Generate token
SONAR_TOKEN=

# github.com > Settings > Developer settings > Fine-grained token (repo: medvault, Contents: read and write)
GITHUB_USERNAME=Sagar-nayar
GITHUB_TOKEN=

# discord channel > Edit channel > Integrations > Webhooks > New webhook > Copy URL
DISCORD_WEBHOOK_URL=

# any long random strings (different for each env)
SESSION_SECRET_STAGING=
SESSION_SECRET_PRODUCTION=

GRAFANA_ADMIN_PASSWORD=change-me-too
