{
  "name": "medvault",
  "version": "1.1.0",
  "description": "Zero Trust Patient Data Access System - ACUCyS × DSEC Hackathon 2026",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:smoke": "vitest run --config vitest.smoke.config.js --reporter=default --reporter=junit --outputFile.junit=reports/junit-smoke.xml",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0 --format checkstyle --output-file reports/eslint-checkstyle.xml",
    "quality:gate": "node scripts/quality-gate.mjs",
    "simulate:traffic": "node scripts/simulate-traffic.mjs",
    "simulate:incident": "node scripts/simulate-incident.mjs"
  },
  "keywords": [
    "zero-trust",
    "healthcare",
    "security",
    "hackathon"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-formatter-checkstyle": "^8.40.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
