# Staging environment (non-secret values only - secrets come from Jenkins credentials)
APP_ENV=staging
HOST_PORT=3001
LOG_LEVEL=debug
SEED_COUNT=20
SESSION_TTL_MINUTES=60
MEMORY_LIMIT=256m
CORS_ORIGINS=http://localhost:3001
# high because the pipeline's traffic simulator logs in a lot from one IP. a real site would use ~10
LOGIN_RATE_LIMIT_PER_MINUTE=600
