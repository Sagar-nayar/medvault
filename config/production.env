# Production environment (non-secret values only - secrets come from Jenkins credentials)
APP_ENV=production
HOST_PORT=3000
LOG_LEVEL=info
SEED_COUNT=50
SESSION_TTL_MINUTES=30
MEMORY_LIMIT=384m
CORS_ORIGINS=http://localhost:3000
# high because the pipeline's traffic simulator logs in a lot from one IP. a real site would use ~10
LOGIN_RATE_LIMIT_PER_MINUTE=600
